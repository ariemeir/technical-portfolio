<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000" >

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/textView1"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal|center_vertical"
            android:gravity="center_vertical|center_horizontal"
            android:text="Calibration Console"
            android:textColor="#ffffff"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/distance_dependence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearLayout1"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/textView12"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal|center_vertical"
            android:gravity="center_vertical|center_horizontal"
            android:text="Actuator-Implant distance dependence calibration"
            android:background="#704000"
            android:textColor="#ffffff"
            android:textSize="20sp" />
    </LinearLayout>
    
    
    
    


   <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radiogroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_below="@+id/distance_dependence" >
 
    <RadioGroup
        android:id="@+id/calib_seq"
        android:layout_width="fill_parent"
    	android:layout_height="wrap_content"
    	android:orientation="horizontal">
        
    
        <RadioButton
            android:id="@+id/preprogrammed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preprogrammed          " 
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:checked="true" />
        
        	
        <RadioButton
            android:id="@+id/customseq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:text="Custom" 
            android:layout_alignParentRight="true"/>
    </RadioGroup>
 
</LinearLayout>

       <LinearLayout
        android:id="@+id/adjsequence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/radiogroup"
        android:background="#251025"
        android:minHeight="20dip"
        android:visibility="visible" >

        <TextView
            android:id="@+id/textView101"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="left|center_vertical"
            android:gravity="left|center_vertical"
            android:text="Adjustment sequence:"
            android:textColor="#ffffff"
            android:textSize="20sp" />
           
           <EditText
            android:id="@+id/textView22"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:gravity="left|center_vertical"
            android:text="+20,+20"
            android:inputType="@null" 
            android:textColor="#ffffff"
            android:textSize="20sp" />
       </LinearLayout>
       
       <LinearLayout
        android:id="@+id/calibrateLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/adjsequence"
        android:background="#251025"
        android:minHeight="20dip"
        android:visibility="visible" >
           
           
           <Button
                     android:id="@+id/calibrate_distance_dependence_button"
                     android:layout_width="fill_parent"
                     android:layout_height="wrap_content"
                     android:layout_gravity="center_horizontal|center_vertical"
                     android:gravity="center_horizontal|center_vertical"
                     android:background="#0000ff"
                     android:textColor="#ffffff"
                     android:clickable="true"
                     android:text="Calibrate"
                     android:textSize="25sp" />
    </LinearLayout>
   
     <LinearLayout
        android:id="@+id/extension_variation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/calibrateLayout1"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/textView11"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal|center_vertical"
            android:gravity="center_vertical|center_horizontal"
            android:text="Extension distance calibration"
            android:textColor="#ffffff"
            android:background="#704000"
            android:textSize="20sp" />
    </LinearLayout>
       

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radiogroup2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_below="@+id/extension_variation" >
 
    <RadioGroup
        android:id="@+id/calib_seq2"
        android:layout_width="fill_parent"
    	android:layout_height="wrap_content"
    	android:orientation="horizontal">
        
    
        <RadioButton
            android:id="@+id/preprogrammed2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preprogrammed          " 
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:checked="true" />
        
        	
        <RadioButton
            android:id="@+id/customseq2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:text="Custom"/>
    </RadioGroup>
 
</LinearLayout>

       <LinearLayout
        android:id="@+id/adjsequence2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/radiogroup2"
        android:background="#251025"
        android:minHeight="20dip"
        android:visibility="visible" >

        <TextView
            android:id="@+id/textView222"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="left|center_vertical"
            android:gravity="left|center_vertical"
            android:text="Adjustment sequence:"
            android:textColor="#ffffff"
            android:textSize="20sp" />
           
           <EditText
            android:id="@+id/textView223"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:gravity="left|center_vertical"
            android:text="+20,+20,-20"
            android:inputType="@null"
            android:textColor="#ffffff"
            android:textSize="20sp" />
       </LinearLayout>

       
        <LinearLayout
        android:id="@+id/calibrateLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/adjsequence2"
        android:background="#251025"
        android:minHeight="20dip"
        android:visibility="visible" >
           
           
           <Button
                     android:id="@+id/calibrate_extension_distance_button"
                     android:layout_width="fill_parent"
                     android:layout_height="wrap_content"
                     android:layout_gravity="center_horizontal|center_vertical"
                     android:gravity="center_horizontal|center_vertical"
                     android:background="#0000ff"
                     android:textColor="#ffffff"
                     android:clickable="true"
                     android:text="Calibrate"
                     android:textSize="25sp" />
    </LinearLayout>
     
     
   
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/calibrateLayout2"
        android:background="#704000"
        android:minHeight="20dip"
        android:visibility="visible" >

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:gravity="center_vertical|center_horizontal"
            android:text="Measured Parameters"
            android:textColor="#ffffff"
            android:textSize="20sp" />
    </LinearLayout>

    
    
    
    
    <TableLayout
        android:id="@+id/tableCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/linearLayout2"
        android:background="#000000"
        android:stretchColumns="*" >

        <TableRow
            android:layout_margin="2dp"
            android:background="#251025"
            android:minHeight="20dip" >

            <TextView
                android:text="Current"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:width="120dip" />

            <TextView
                android:id="@+id/current_value"
                android:gravity="right"
                android:paddingRight="20dip"
                android:text="--"
                android:textColor="#ffff00"
                android:textSize="24sp"
                android:width="120dip" />

            <TextView
                android:gravity="left|center"
                android:paddingRight="20dip"
                android:text="mA"
                android:textColor="#50FF50"
                android:textSize="20sp"
                android:width="75dip" />

        </TableRow>
		</TableLayout>

        <ScrollView
	    xmlns:android="http://schemas.android.com/apk/res/android"
	    android:id="@+id/currentChartScroll"
	    android:layout_width="fill_parent"
	    android:layout_height="100dip"
	    android:layout_below="@id/tableCurrent" >

		<LinearLayout
		    android:id="@+id/currentchartcontainer"
		    android:layout_width="fill_parent"
		    android:layout_height="100dip"
		    android:orientation="vertical" >
	
			<LinearLayout
			    xmlns:android="http://schemas.android.com/apk/res/android"
			    android:id="@+id/currentChart"
			    android:layout_width="fill_parent"
			    android:layout_height="100dip"
			    android:layout_marginRight="10dip" />

		</LinearLayout>
	 </ScrollView>
     
    
      
    
    	   <TableLayout
        android:id="@+id/tableVoltage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/currentChartScroll"
        android:background="#000000"
        android:stretchColumns="*" >
    	
        <TableRow
            android:layout_margin="2dp"
            android:background="#251025"
            android:minHeight="20dip" >

            <TextView
                android:text="Voltage"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:width="120dip" />

            <TextView
                android:id="@+id/voltage_value"
                android:layout_width="match_parent"
                android:gravity="right"
                android:paddingRight="20dip"
                android:text="--"
                android:textColor="#ffff00"
                android:textSize="24sp"
                android:width="120dip" />

            <TextView
                android:layout_gravity="left"
                android:gravity="left|center_vertical"
                android:paddingRight="20dip"
                android:text="V"
                android:textColor="#50FF50"
                android:textSize="20sp"
                android:width="75dip" />

        </TableRow>
    </TableLayout>

        <ScrollView
	    xmlns:android="http://schemas.android.com/apk/res/android"
	    android:id="@+id/chartVoltageScroll"
	    android:layout_width="fill_parent"
	    android:layout_height="100dip"
	    android:layout_below="@id/tableVoltage" >

		<LinearLayout
		    android:id="@+id/voltageChartContainer"
		    android:layout_width="fill_parent"
		    android:layout_height="100dip"
		    android:orientation="vertical" >
	
			<LinearLayout
			    xmlns:android="http://schemas.android.com/apk/res/android"
			    android:id="@+id/voltageChart"
			    android:layout_width="fill_parent"
			    android:layout_height="100dip"
			    android:layout_marginRight="10dip" />

		</LinearLayout>
	</ScrollView>
    	   
    
    <LinearLayout
        android:id="@+id/linearLayoutSpacer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/chartVoltageScroll"
        android:minHeight="10dip"
        android:orientation="vertical" >

    </LinearLayout>
    
     
    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@id/linearLayoutSpacer1"
        android:background="#704000"
        android:minHeight="0dip"
        android:visibility="visible" >

        <!-- 
        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:gravity="center_vertical|center_horizontal"
            android:text="Estimated Parameters"
            android:textColor="#ffffff"
            android:textSize="20sp" />-->
    </LinearLayout>
 
    <TableLayout
        android:id="@+id/tableLayout3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/linearLayout4"
        android:layout_centerVertical="true"
        android:background="#000000"
        android:stretchColumns="*" >

        <TableRow
            android:layout_margin="2dp"
            android:background="#251025"
            android:minHeight="20dip" >

            <TextView
                android:text="Angular Velocity"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:width="120dip" />

            <TextView
                android:id="@+id/angular_speed_value"
                android:gravity="right"
                android:paddingRight="20dip"
                android:text="2000"
                android:textColor="#ffff00"
                android:textSize="24sp"
                android:width="120dip" />

            <TextView
                android:layout_gravity="left"
                android:gravity="left|center_vertical"
                android:paddingRight="20dip"
                android:text="rpm"
                android:textColor="#50FF50"
                android:textSize="20sp"
                android:width="75dip" />

        </TableRow>

    </TableLayout>    
         
    <TableLayout
        android:id="@+id/tableLayoutButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/tableLayout3"
        android:layout_centerVertical="true"
        android:background="#000000"
        android:stretchColumns="*" >
        <TableRow
            android:layout_margin="2dp"
            android:background="#251025"
            android:minHeight="20dip" >
        
         <RelativeLayout
                    android:id="@+id/manual_control_button_container"
                    android:layout_width="250dip"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tableLayout3"
                    android:layout_centerHorizontal="true"
                    android:background="#251025"
                    android:layout_marginTop="4dp" >

                    <ImageButton
                        android:id="@+id/plus_button"
                        android:layout_width="120dip"
                        android:layout_height="120dip"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentTop="true"
                        android:background="#251025"
                        android:clickable="false"
                        android:src="@drawable/plus"
                        android:textSize="50sp" />

                    <ImageButton
                        android:id="@+id/minus_button"
                        android:layout_width="120dip"
                        android:layout_height="120dip"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentTop="true"
                        android:background="#251025"
                        android:clickable="false"
                        android:src="@drawable/minus"
                        android:textSize="50sp" />

                </RelativeLayout>
        </TableRow>
        </TableLayout>
        
      

    <TableLayout
        android:id="@+id/tableLayoutTorque"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/tableLayoutButtons"
        android:layout_centerVertical="true"
        android:background="#000000"
        android:stretchColumns="*" >


        <TableRow
            android:layout_margin="2dp"
            android:background="#251025"
            android:minHeight="20dip" >

            <TextView
                android:text="Torque"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:width="120dip" />

            <TextView
                android:layout_gravity="right"
                android:gravity="right"
                android:paddingRight="20dip"
                android:text="24"
                android:textColor="#ffff00"
                android:textSize="24sp" />

            <TextView
                android:gravity="left"
                android:paddingRight="0dip"
                android:text="mN m"
                android:textColor="#50FF50"
                android:textSize="20sp"
                android:width="60dip" />

        </TableRow>
    </TableLayout>    
    

</RelativeLayout>
