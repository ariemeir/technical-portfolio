<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	android:id="@+id/scrollview"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:background="#251025"
	android:textColor="#ffffff"
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_weight="1"
	>
 <LinearLayout
                    android:id="@+id/LinearLayout01"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" >
    >
    
    <TableLayout
        android:id="@+id/tableLayout1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/linearLayout4"
        android:layout_centerVertical="true"
        android:background="#000000"
        android:stretchColumns="*" >

        <TableRow
            android:layout_margin="2dp"
            android:background="#251025"
            android:minHeight="20dip" >

            <TextView
                android:text="Total #steps"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:width="120dip" />

            <TextView
                android:id="@+id/steps_number"
                android:gravity="right"
                android:paddingRight="20dip"
                android:text="3"
                android:textColor="#ffff00"
                android:textSize="24sp"
                android:width="120dip" />

            <TextView
                android:layout_gravity="left"
                android:gravity="left|center_vertical"
                android:paddingRight="20dip"
                android:text=""
                android:textColor="#50FF50"
                android:textSize="20sp"
                android:width="75dip" />

        </TableRow>

        
        <TableRow
            android:layout_margin="2dp"
            android:background="#251025"
            android:minHeight="20dip" >

            <TextView
                android:text="Current step#"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:width="120dip" />

            <TextView
                android:id="@+id/current_step"
                android:gravity="right"
                android:paddingRight="20dip"
                android:text="1"
                android:textColor="#ffff00"
                android:textSize="24sp"
                android:width="120dip" />

            <TextView
                android:layout_gravity="left"
                android:gravity="left|center_vertical"
                android:paddingRight="20dip"
                android:text=""
                android:textColor="#50FF50"
                android:textSize="20sp"
                android:width="75dip" />

        </TableRow>
        
        
    </TableLayout>
              <LinearLayout
                    android:id="@+id/LinearLayout01"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tableLayout1"
                    android:layout_weight="1"
                    android:orientation="vertical" >

                    <TextView
                        android:id="@+id/adjustment_progress_textview"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:background="#704000"
                        android:gravity="center_horizontal"
                        android:text="Current Step Progress"
                        android:textColor="#ffffff"
                        android:textSize="22sp" />

                    <TableLayout
                        android:id="@+id/TableLayout01"
                        android:layout_width="340dip"
                        android:layout_height="60dip"
                        android:layout_marginTop="2dp" >

                        <TableRow
                            android:id="@+id/TableRow03"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:layout_marginTop="2dp"
                            android:background="#251025"
                            android:paddingLeft="30dip" >

						<ProgressBar 
						    	android:id="@+id/stepProgressBar"
            					android:layout_width="480dip" 
            					style="?android:attr/progressBarStyleHorizontal"
            					android:max="100" 
            					android:progress="0"
            					android:layout_height="60dip">
						    
						</ProgressBar>                        
            			</TableRow>
                    </TableLayout>
                </LinearLayout>
    

              <LinearLayout
                    android:id="@+id/LinearLayout03"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/LinearLayout01"
                    android:layout_weight="1"
                    android:orientation="vertical" >

                    <TextView
                        android:id="@+id/calib_progress_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:background="#704000"
                        android:gravity="center_horizontal"
                        android:text="CalibrationProgress"
                        android:textColor="#ffffff"
                        android:textSize="22sp" />

                    <TableLayout
                        android:id="@+id/TableLayout01"
                        android:layout_width="340dip"
                        android:layout_height="60dip"
                        android:layout_marginTop="2dp" >

                        <TableRow
                            android:id="@+id/TableRow03"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:layout_marginTop="2dp"
                            android:background="#251025"
                            android:paddingLeft="30dip" >

						<ProgressBar 
						    	android:id="@+id/calibProgressBar"
            					android:layout_width="480dip" 
            					style="?android:attr/progressBarStyleHorizontal"
            					android:max="10" 
            					android:progress="0"
            					android:layout_height="60dip">
						    
						</ProgressBar>                        
            			</TableRow>
                    </TableLayout>
                </LinearLayout>

</LinearLayout>
</ScrollView>