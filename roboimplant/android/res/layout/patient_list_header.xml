<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
android:id="@+id/header_rel_layout"
android:layout_width="fill_parent"
android:background="#704000"
android:layout_height="40dip"
xmlns:android="http://schemas.android.com/apk/res/android"
>

	<TextView
	android:id="@+id/patient_id_label"
	android:layout_width="80dip"
	android:layout_height="wrap_content"
	android:padding="5px"
	android:text="ID"
	android:textStyle="bold"
	android:textSize="22sp"
	android:background="#704000"
	android:textColor="#ffffff"
	android:layout_alignParentTop="true"
	android:layout_alignParentLeft="true"
	>
	</TextView>
	<TextView
	android:id="@+id/patient_name_label"
	android:layout_width="200dip"
	android:layout_height="wrap_content"
	android:padding="0px" 
	android:textSize="22sp"
	android:background="#704000"
	android:textColor="#ffffff"
	android:text="Name"
	android:layout_alignParentTop="true"
	android:layout_toRightOf="@+id/patient_id_label"
	>
	</TextView>
	<TextView
	android:id="@+id/implant_date_label"
	android:layout_width="200dip"
	android:layout_height="wrap_content"
	android:background="#704000"
	android:textColor="#ffffff"
	android:textSize="22sp"
	android:text="Implant Date"
	android:padding="0px"
	android:layout_alignParentTop="true"
	android:layout_toRightOf="@+id/patient_name_label"
	>
	</TextView>
 	
</LinearLayout>
