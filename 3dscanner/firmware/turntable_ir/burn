#!/usr/bin/env bash
#
# burn — compile an .ino, show any problems, ask, then upload to the Arduino.
#
#   ./burn ir_blaster.ino              compile, confirm, upload
#   ./burn ir_blaster.ino -y           skip the confirmation
#   ./burn ir_blaster.ino --port /dev/cu.usbmodemXXXXX
#   ./burn ir_blaster.ino --fqbn arduino:avr:nano
#   ./burn --check ir_blaster.ino      compile only, never upload
#
# Needs arduino-cli:
#   brew install arduino-cli
#   arduino-cli core update-index
#   arduino-cli core install arduino:avr
#   arduino-cli lib install IRremote
#
set -euo pipefail

SKETCH=""; PORT=""; FQBN=""; ASSUME_YES=0; CHECK_ONLY=0

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
err()  { printf '\033[31m%s\033[0m\n' "$1" >&2; }
ok()   { printf '\033[32m%s\033[0m\n' "$1"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)    ASSUME_YES=1; shift ;;
    --check)     CHECK_ONLY=1; shift ;;
    -p|--port)   PORT="$2"; shift 2 ;;
    -b|--fqbn)   FQBN="$2"; shift 2 ;;
    -h|--help)   awk 'NR>1{ if (/^#/) { sub(/^# ?/,""); print } else exit }' "$0"; exit 0 ;;
    -*)          err "unknown option: $1"; exit 2 ;;
    *)           SKETCH="$1"; shift ;;
  esac
done

[[ -n "$SKETCH" ]] || { err "usage: burn <sketch.ino> [-y] [--port P] [--fqbn F]"; exit 2; }
[[ -f "$SKETCH" ]] || { err "no such file: $SKETCH"; exit 2; }

command -v arduino-cli >/dev/null 2>&1 || {
  err "arduino-cli not found. Install it:"
  err "  brew install arduino-cli"
  err "  arduino-cli core update-index && arduino-cli core install arduino:avr"
  exit 127
}

# --- arduino-cli insists the sketch folder be named after the .ino ---------
# If it already is, build in place (keeps any local headers working).
# Otherwise stage a copy in a temp dir with the right shape.
SKETCH_ABS="$(cd "$(dirname "$SKETCH")" && pwd)/$(basename "$SKETCH")"
BASE="$(basename "$SKETCH" .ino)"
PARENT="$(basename "$(dirname "$SKETCH_ABS")")"

if [[ "$PARENT" == "$BASE" ]]; then
  SKETCH_DIR="$(dirname "$SKETCH_ABS")"
else
  STAGE="$(mktemp -d)"; trap 'rm -rf "$STAGE"' EXIT
  SKETCH_DIR="$STAGE/$BASE"
  mkdir -p "$SKETCH_DIR"
  cp "$SKETCH_ABS" "$SKETCH_DIR/$BASE.ino"
  # bring along any sibling headers the sketch might include
  find "$(dirname "$SKETCH_ABS")" -maxdepth 1 \( -name '*.h' -o -name '*.hpp' \) \
       -exec cp {} "$SKETCH_DIR/" \; 2>/dev/null || true
fi

# --- find the board -------------------------------------------------------
BOARD_LINE="$(arduino-cli board list 2>/dev/null | grep -iE 'usbmodem|usbserial|ttyacm|ttyusb' | head -1 || true)"

if [[ -z "$PORT" ]]; then
  PORT="$(awk '{print $1}' <<<"$BOARD_LINE")"
fi
if [[ -z "$FQBN" ]]; then
  FQBN="$(grep -oE '[a-z0-9_]+:[a-z0-9_]+:[a-z0-9_]+' <<<"$BOARD_LINE" | head -1 || true)"
  [[ -n "$FQBN" ]] || FQBN="arduino:avr:uno"   # sensible default for this project
fi

bold "sketch : $BASE.ino"
bold "board  : $FQBN"
[[ $CHECK_ONLY -eq 1 ]] || bold "port   : ${PORT:-<none found>}"
echo

# --- compile --------------------------------------------------------------
bold "compiling..."
if ! arduino-cli compile --fqbn "$FQBN" --warnings default "$SKETCH_DIR"; then
  echo; err "compile FAILED — not uploading."
  exit 1
fi
ok "compile ok"
echo

[[ $CHECK_ONLY -eq 0 ]] || { ok "--check: stopping before upload."; exit 0; }

[[ -n "$PORT" ]] || {
  err "No board detected. Plug it in, or pass --port."
  err "Ports seen:"; arduino-cli board list >&2
  exit 1
}

# --- confirm --------------------------------------------------------------
if [[ $ASSUME_YES -eq 0 ]]; then
  printf 'Upload %s to %s? [y/N] ' "$BASE.ino" "$PORT"
  read -r reply </dev/tty
  case "$reply" in
    [yY]|[yY][eE][sS]) ;;
    *) echo "aborted."; exit 0 ;;
  esac
fi

# --- upload ---------------------------------------------------------------
echo
bold "uploading..."
if ! arduino-cli upload -p "$PORT" --fqbn "$FQBN" "$SKETCH_DIR"; then
  echo
  err "upload FAILED."
  err "Most common cause: something else is holding the port."
  err "  lsof $PORT      # then close the Serial Monitor / kill the PID"
  exit 1
fi
ok "done — $BASE.ino is running on $PORT"
